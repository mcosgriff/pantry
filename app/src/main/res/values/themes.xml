<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app starts (core-splashscreen), then swapped for Theme.Pantry. -->
    <style name="Theme.Pantry.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pantry</item>
    </style>

    <style name="Theme.Pantry" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
