<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reads barcodes on the Scan screen (#10), asked for when that screen first opens. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
        Product lookup in Open Food Facts, only after the user says yes (#9, docs/adr/0001), and reading a recipe
        page the user shares or pastes, only when they tap Read recipe (#43, docs/adr/0003).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        The daily expiry digest (#27): asked for in Pantry settings when an expiration alert is turned on
        (Android 13 and later). The digest's alarm is inexact, so no SCHEDULE_EXACT_ALARM.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sets the digest's alarm again after a restart, which clears alarms (#27). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        No Android auto-backup: the pantry stays on this phone until the app has its own export.
    -->
    <application
        android:name=".PantryApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pantry.Starting"
        tools:targetApi="37">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share → Pantry on a recipe page: opens Meal prep's import with the link (#43, docs/adr/0003). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- The daily digest's alarm; only the app's own PendingIntent reaches it. -->
        <receiver
            android:name=".notify.DigestReceiver"
            android:exported="false" />
        <!-- Sets the digest's alarm again; exported only so that Android's own broadcasts reach it. -->
        <receiver
            android:name=".notify.DigestRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
