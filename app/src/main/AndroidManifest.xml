<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reads barcodes on the Scan screen (#10), asked for when that screen first opens. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Product lookup in Open Food Facts, only after the user says yes (#9, docs/adr/0001). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        No Android auto-backup: the pantry stays on this phone until the app has its own export.
    -->
    <application
        android:name=".PantryApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pantry.Starting"
        tools:targetApi="37">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
